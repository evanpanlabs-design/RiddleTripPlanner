# Riddle 环境变量模板 · Environment template
# 复制为 .env 后填值；所有密钥也可以在设置界面（UI 右上角 ⚙）里配置，界面值优先于环境变量。
# Copy to .env and fill in. Every key can also be set in the in-app Settings panel (⚙), which takes precedence over env vars.

# ---- Jev / TypeSafe System One（判断引擎 · judgment engine, required）----
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1

# ---- LLM（生成层 · generation layer, required; 默认 DeepSeek，可在设置中切换 Claude/OpenAI/GLM/自定义）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 其他 provider 的环境变量名（在设置里选用时生效 · used when selected in Settings）:
# ANTHROPIC_API_KEY= / OPENAI_API_KEY= / GLM_API_KEY= / LLM_API_KEY + LLM_BASE_URL + LLM_MODEL=

# ---- 高德 AMap（地图数据源 · map data & tiles）----
# 服务端 Web 服务 key（POI 搜索/路线规划 · server-side POI search & routing）
AMAP_WEB_SERVICE_KEY=
# 浏览器端 JSAPI key + 安全密钥（前端地图底图 · frontend map tiles）
AMAP_JSAPI_KEY=
AMAP_SECURITY_JSCODE=

# ---- 百度 Baidu（预留 · reserved: 下一版火车/飞机等更丰富数据源）----
BAIDU_MAP_AK=
BAIDU_WEBJS_AK=

# ---- 可选 · optional ----
# RIDDLE_PORT=8787
